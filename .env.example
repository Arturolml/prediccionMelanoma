# Copiar a .env (que NO va en git) y completar. docker compose lo lee solo.
#
# Contraseña de Postgres: usar solo letras y números (va dentro de DATABASE_URL).
# La anterior estuvo publicada en el repositorio: hay que considerarla expuesta.
# Si la base ya existe, cambiar la variable NO cambia la contraseña real; además:
#   docker compose exec db_postgres psql -U prediccion -d prediccion-db \
#     -c "ALTER USER prediccion WITH PASSWORD 'la-nueva';"
POSTGRES_PASSWORD=

# Secreto de los JWT: al menos 32 caracteres aleatorios. Generar con:
#   openssl rand -hex 32
# Cambiarlo invalida las sesiones abiertas (hay que volver a iniciar sesión).
JWT_SECRET=
